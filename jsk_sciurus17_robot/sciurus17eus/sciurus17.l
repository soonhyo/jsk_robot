  ;; pre-defined pose methods

    (:reset-pose (&optional (limbs '(:head :torso :rhand :lhand :rarm :larm)))
      "Predefined pose named reset-pose."
      (unless (listp limbs) (setq limbs (list limbs)))
      (dolist (limb limbs)
        (case limb
          (:head (send self limb :angle-vector (float-vector 0.000000 0.000000)))
          (:torso (send self limb :angle-vector (float-vector 0.000000)))
          (:rhand (send self limb :angle-vector (float-vector 0.000000)))
          (:lhand (send self limb :angle-vector (float-vector 0.000000)))
          (:rarm (send self limb :angle-vector (float-vector 0.000000 -90.000000 0.000000 156.200000 0.000000 -120.000000 0.000000)))
          (:larm (send self limb :angle-vector (float-vector 0.000000 90.000000 0.000000 -156.200000 0.000000 120.000000 0.000000)))
          (t (format t "Unknown limb is passed: ~a~%" limb))))
      (send self :angle-vector))
    (:init-pose (&optional (limbs '(:head :torso :rhand :lhand :rarm :larm)))
      "Predefined pose named init-pose."
      (unless (listp limbs) (setq limbs (list limbs)))
      (dolist (limb limbs)
        (case limb
          (:head (send self limb :angle-vector (float-vector 0.000000 0.000000)))
          (:torso (send self limb :angle-vector (float-vector 0.000000)))
          (:rhand (send self limb :angle-vector (float-vector 0.000000)))
          (:lhand (send self limb :angle-vector (float-vector 0.000000)))
          (:rarm (send self limb :angle-vector (float-vector 0.000000 -85.940000 0.000000 120.320000 0.000000 -114.590000 0.000000)))
          (:larm (send self limb :angle-vector (float-vector 0.000000 85.940000 0.000000 -120.320000 0.000000 114.590000 0.000000)))
          (t (format t "Unknown limb is passed: ~a~%" limb))))
      (send self :angle-vector))
