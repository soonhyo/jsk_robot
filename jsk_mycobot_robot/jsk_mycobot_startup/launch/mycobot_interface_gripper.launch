<launch>
	<!-- Select connecting device and serial port ，选择连接设备及串口-->
	<arg name="port" default="/dev/ttyACM0" />
	<arg name="baud" default="115200" />
    <arg name="load_robot_state_publisher" default="true"/>

	<!-- <arg name="model" default="$(find mycobot_description)/urdf/mycobot_280_m5/mycobot_280_m5.urdf"/> -->
	<!-- <arg name="model" default="$(find mycobot_description)/urdf/mycobot_280_m5/mycobot_280m5_with_gripper_up.urdf"/> -->
	<arg name="model" default="$(find mycobot_description)/urdf/mycobot_280_m5/mycobot_280m5_with_gripper_parallel.urdf"/>
    <arg name="rviz" default="true" />
    <arg name="rvizconfig" default="$(find jsk_mycobot_startup)/config/mycobot.rviz" />

	<param name="robot_description" command="$(find xacro)/xacro --inorder $(arg model)" />

	<!-- Combinejoin values to TF ,将值合并到TF-->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"  if="$(arg load_robot_state_publisher)" />

	<!-- Show in Rviz ，显示在Rviz-->
	<node name="rviz" pkg="rviz" type="rviz" args="-d $(arg rvizconfig)" if="$(arg rviz)" />

    <include file="$(find mycobot_communication)/launch/communication_service_topic.launch">
		<arg name="port" value="$(arg port)" />	
		<arg name="baud" value="$(arg baud)" />	
    </include>
	<node name="real_listener_gripper" pkg="mycobot_280" type="listen_real_gripper.py" output="screen">
        <param name="port" value="$(arg port)" />
        <param name="baud" value="$(arg baud)" />
    </node>
</launch>
